with "config/lua_ada_config.gpr";
project Lua_Ada is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Lua_Ada_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("lua_ada.adb");

   package Compiler is
      --  Apply the project baseline after Alire's profile switches.
      for Default_Switches ("Ada") use
        Lua_Ada_Config.Ada_Compiler_Switches &
        ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatv", "-gnaty");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");  --  Symbolic traceback
   end Binder;

end Lua_Ada;
