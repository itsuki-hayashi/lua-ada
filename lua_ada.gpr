with "config/lua_ada_config.gpr";
with "runtime_configuration";

library project Lua_Ada is
   type Library_Type is ("static", "static-pic", "relocatable");
   Library_Mode : Library_Type :=
     external ("LUA_ADA_LIBRARY_TYPE", "static");
   --  A conformance campaign builds the runtime once before linking its
   --  independent hosts. Imported projects must not rebind or replace that
   --  image: executable and allocation evidence refers to its exact bytes.
   type Build_Choice is ("false", "true");
   Prebuilt : Build_Choice := external ("LUA_ADA_PREBUILT", "false");
   for Externally_Built use Prebuilt;
   Configuration_Subdir := Runtime_Configuration.Artifact_Subdir;
   Tasking_Runtime_Archive :=
     external ("LUA_ADA_TASKING_RUNTIME_ARCHIVE", "");
   Runtime_Library_Directory :=
     external ("LUA_ADA_RUNTIME_LIBRARY_DIR", "");
   Runtime_Search_Options := ();
   case Lua_Ada_Config.Alire_Host_OS is
      when "macos" =>
         case Runtime_Library_Directory is
            when "" => null;
            when others =>
               Runtime_Search_Options :=
                 ("-Wl,-rpath," & Runtime_Library_Directory);
         end case;
      when others => null;
   end case;
   C_ABI_Defines := ();
   C_Runtime_Defines := ();
   case Runtime_Configuration.Configuration is
      when "default" => null;
      when "upstream-test" =>
         C_Runtime_Defines := ("-DLUA_ADA_AUXILIARY_BUFFER_BYTES=23");
   end case;
   C_Platform_Defines := ();
   Module_Link_Options := ();
   C_Unwind_Options := ();
   case Lua_Ada_Config.Alire_Host_OS is
      when "windows" =>
         case Lua_Ada_Config.Alire_Host_Arch is
            when "x86_64" =>
               --  GNU's BigObj partial link merges ordinary C .text/.xdata
               --  section symbols, losing their distinct unwind offsets.
               --  Unique function sections preserve each .pdata target;
               --  Ada already emits its execution code in such sections.
               C_Unwind_Options := ("-ffunction-sections");
            when others => null;
         end case;
         --  Static Windows hosts also export the actual public C surface.
         --  Native modules import that executable's one runtime image via
         --  a host-name-bound import library, never a second static archive.
         C_ABI_Defines :=
           ("-DLUA_BUILD_AS_DLL", "-DLUA_CORE", "-DLUA_LIB");
      when "linux" =>
         C_Platform_Defines := ("-DLUA_USE_LINUX");
         Module_Link_Options := ("-ldl");
         case Library_Mode is
            when "relocatable" => null;
            when others =>
               Module_Link_Options := Module_Link_Options &
                 ("-Wl,--export-dynamic");
         end case;
      when "macos" =>
         C_Platform_Defines := ("-DLUA_USE_MACOSX");
         case Library_Mode is
            when "relocatable" => null;
            when others => Module_Link_Options := ("-Wl,-export_dynamic");
         end case;
      when others => null;
   end case;

   --  Ada hosts, C hosts and their native modules import this same image.
   --  A second facade SAL would duplicate world/pool/elaboration ownership.
   for Languages use ("Ada", "C");
   for Source_Dirs use
     ("src/", "src/platform", "config/", "c_api/ada", "c_api/c",
      Runtime_Configuration.Source_Directory);
   for Object_Dir use
     "obj/" & Configuration_Subdir &
     Lua_Ada_Config.Build_Profile & "/" & Library_Mode;
   for Library_Dir use
     "lib/" & Configuration_Subdir &
     Lua_Ada_Config.Build_Profile & "/" & Library_Mode;
   for Library_Name use "lua";
   for Library_Kind use Library_Mode;
   for Library_Standalone use "standard";
   for Library_Auto_Init use "true";
   for Library_Symbol_Policy use "unrestricted";
   for Create_Missing_Dirs use "True";

   --  Standard SAL interfaces describe the complete imported Ada closure.
   --  Child AUnit packages inspect private units; listing them here preserves
   --  that test access without changing any Ada visibility declaration.
   --  New first-party specs used by consumers belong in this reviewed list.
   for Interfaces use
     (
      "lua_ada_boundary.c",
      "lua_ada_libraries.c",
      "lua_ada_debug.c",
      "lua_ada_builtins.c",
      "lua_ada_format.c",
      "lua_ada_auxiliary.c",
      "lua_ada_buffer.c",
      "lua_ada_allocator.c",
      "lua_ada_substitution.c",
      "lua_ada_modules.c",
      "lua_ada_host_numerics.c",
      "lua_ada_streams.c",
      "lua_ada_os.c",
      "lua_ada_locales.c",
      "lua-engine-external_releases.ads",
      "lua-engine-file_inputs.ads",
      "lua-engine-c_operators.ads",
      "lua_ada_config.ads",
      "lua-c_api.ads",
      "lua-big_naturals.ads",
      "lua-builtin_registry.ads",
      "lua-canonical_compiler.ads",
      "lua-chunks.ads",
      "lua-diagnostics.ads",
      "lua-engine-call_names.ads",
      "lua-engine-canonical.ads",
      "lua-engine-compiler.ads",
      "lua-engine-core_libraries.ads",
      "lua-engine-foreign.ads",
      "lua-engine-foreign_hooks.ads",
      "lua-engine-finalizers.ads",
      "lua-engine-garbage_collection.ads",
      "lua-engine-format_drivers.ads",
      "lua-engine-file_resources.ads",
      "lua-engine-formats.ads",
      "lua-engine-inspection.ads",
      "lua-engine-io_libraries.ads",
      "lua-engine-library_openers.ads",
      "lua-engine-loaders.ads",
      "lua-engine-native_modules.ads",
      "lua-engine-machine.ads",
      "lua-engine-mathematics.ads",
      "lua-engine-operating_system.ads",
      "lua-engine-packing.ads",
      "lua-engine-pattern_drivers.ads",
      "lua-engine-patterns.ads",
      "lua-engine-strings.ads",
      "lua-engine-stacks.ads",
      "lua-engine-system_results.ads",
      "lua-engine-sorting.ads",
      "lua-engine-table_drivers.ads",
      "lua-engine-tables.ads",
      "lua-engine-unicode.ads",
      "lua-engine-warnings.ads",
      "lua-engine.ads",
      "lua-frontend_text.ads",
      "lua-diagnostic_text.ads",
      "lua-integers.ads",
      "lua-inputs.ads",
      "lua-lexer_core.ads",
      "lua-lexers.ads",
      "lua-numbers.ads",
      "lua-number_parsing.ads",
      "lua-opcodes.ads",
      "lua-platform_mathematics.ads",
      "lua-platform_locales.ads",
      "lua-platform_os.ads",
      "lua-platform_modules.ads",
      "lua-platform_numerics.ads",
      "lua-platform_streams.ads",
      "lua-prototypes.ads",
      "lua-runtime_configuration.ads",
      "lua-sessions.ads",
      "lua-sources.ads",
      "lua-storage-buffers.ads",
      "lua-storage-fixed_arenas.ads",
      "lua-storage-vectors.ads",
      "lua-storage.ads",
      "lua-syntax_trees.ads",
      "lua-syntax.ads",
      "lua.ads");

   case Library_Mode is
      when "relocatable" =>
         case Lua_Ada_Config.Alire_Host_OS is
            when "windows" =>
               --  C dllexport declarations disable MinGW's automatic exports.
               --  Ada clients also need real spec/data/controlled-type symbols.
               for Library_Options use ("-lm", "-Wl,--export-all-symbols");
            when "macos" =>
               --  Child shells can strip DYLD variables. Record the selected
               --  compiler runtime location in the actual shared image too.
               for Library_Options use ("-lm") & Runtime_Search_Options;
            when others =>
               for Library_Options use ("-lm") & Module_Link_Options;
         end case;
      when others =>
         --  Static Library_Options are archive members, not final-link flags.
         --  Ada pragmas and each C consumer provide their required -lm link.
         null;
   end case;

   package Compiler is
      for Default_Switches ("Ada") use
        Lua_Ada_Config.Ada_Compiler_Switches &
        ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatv", "-gnaty",
         "-gnatVF");
      --  IEEE NaNs/infinities are Lua values: see ADR 0003. Ordinary Ada
      --  runtime checks and all other profile validity checks stay enabled.
      for Default_Switches ("C") use
        ("-std=c99", "-Wall", "-Wextra", "-Werror", "-pedantic",
         "-I" & Project'Project_Dir & "c_api/include",
         "-I" & Project'Project_Dir & "c_api/include/api") &
        C_Platform_Defines & C_ABI_Defines & C_Runtime_Defines &
        C_Unwind_Options;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Linker is
      case Lua_Ada_Config.Alire_Host_OS is
         when "macos" =>
            --  A standard SAL's tasking requirement is not inferred from
            --  its public ALIs by an importing Ada main. Propagate GNARL to
            --  every consumer, not only the C pilot. The selected runtime
            --  archive is discovered by the validation/development driver;
            --  ordinary GPR users retain the compiler's -l search fallback.
            case Tasking_Runtime_Archive is
               when "" =>
                  for Linker_Options use
                    ("-lgnarl") & Runtime_Search_Options & Module_Link_Options;
               when others =>
                  for Linker_Options use
                    (Tasking_Runtime_Archive) & Runtime_Search_Options &
                    Module_Link_Options;
            end case;
         when "linux" =>
            for Linker_Options use Module_Link_Options;
         when others => null;
      end case;
   end Linker;

   case Lua_Ada_Config.Alire_Host_OS is
      when "windows" =>
         case Lua_Ada_Config.Alire_Host_Arch is
            when "x86_64" =>
               --  The SAL's complete Ada closure exceeds ordinary COFF's
               --  section limit. Only its intermediate partial link is BigObj.
               for Library_Partial_Linker use
                 (Compiler'Driver ("Ada"), "-nostdlib", "-no-pie",
                  "-Wl,-r,--oformat,pe-bigobj-x86-64", "-o");
            when others => null;
         end case;
      when others => null;
   end case;
end Lua_Ada;
