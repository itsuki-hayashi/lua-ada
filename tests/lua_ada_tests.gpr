with "lua_ada";
with "aunit";
with "config/lua_ada_tests_config.gpr";

project Lua_Ada_Tests is
   for Source_Dirs use ("src");
   for Object_Dir use
     "obj/" & Lua_Ada_Tests_Config.Build_Profile & "/" &
     Lua_Ada.Library_Mode;
   for Exec_Dir use "bin/" & Lua_Ada.Library_Mode;
   for Main use
     ("test_runner.adb", "lua-opcode_probe.adb", "lexer_probe.adb",
      "syntax_consumer.adb", "upstream_runner.adb",
      "lua-codec_layout_probe.adb");
   package Binder is
      for Default_Switches ("Ada") use ("-Wb");
   end Binder;
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        Lua_Ada_Tests_Config.Ada_Compiler_Switches &
        ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatv", "-gnaty",
         "-gnatVF");
   end Compiler;
end Lua_Ada_Tests;
