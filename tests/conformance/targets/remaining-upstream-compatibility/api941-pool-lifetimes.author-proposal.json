  "review_questions": [
    {
      "id": "selected-owner-capacity-transaction",
      "regions": [
        "Free_Frame",
        "New_Frame",
        "Reserve_Call_Metadata",
        "Grow_Call_Pool"
      ],
      "question": "Verify actual allocated frame capacity includes active/cached/reset/base owners, selected-owner metadata reserve happens before publication, refusal rolls back both owners and capacity, emergency retry remains legitimate, and physical trim never releases a live guard record."
    },
    {
      "id": "pool-owner-generation-and-ack",
      "regions": [
        "Acquire_Call_Record",
        "Release_Call_Record",
        "Discard_Pending",
        "Discard_Self_Calls"
      ],
      "question": "Trace each outstanding record through nested/cross-context entry, shrink, guard ACK, host abort and self-close. Verify owner association plus generation distinguishes reused addresses and reset records, no owner can die before genuine ACK, and reset/return never dereferences a retired activation. The separately pending owner/generation fix must be independently reviewed and recaptured before exact approval."
    },
    {
      "id": "surface-and-control-disposal",
      "regions": [
        "Create_Surface",
        "Release_Context_Control",
        "Destroy_Call_Pool"
      ],
      "question": "Verify weak thread rooting before surface reservation, complete transaction rollback, selected owner on all pool/reset allocations, zero outstanding records before control disposal, release of all nodes and no leaked owner/code callback lifetime."
    },
    {
      "id": "scalar-result-authority-before-collection",
      "regions": [
        "Step",
        "Complete_Canonical_Return",
        "Complete_Packet",
        "Hook_Event"
      ],
      "question": "Verify actual scalar/cell slots root outgoing userdata through closer/return-hook mutation, packet reservation and callbacks; source is retired only after recipient ownership. Duplicate native argument/result/capture roots must disappear before weak/finalizer safe points without losing the only live root."
    },
    {
      "id": "retained-versus-ghost-capacity",
      "regions": [
        "Transfer_Result_Ownership",
        "Complete_Canonical_Return"
      ],
      "question": "Verify copying into a retained empty arena preserves both physical owners while clearing logical sources, cold larger results transfer sole ownership, nil arity/status prefixes and bounded-work charges remain exact. Retained capacity may alter private bytes but cannot retain unreachable userdata/weak identities."
    },
    {
      "id": "api941-actual-lifecycle",
      "regions": [
        "Complete_Packet",
        "Release_Context_Control"
      ],
      "question": "Independently rerun the unchanged source-linked1000-userdata counterpart on final C/Ada images:1000 unique first-cycle callbacks/live userdata, weak values cleared before callback, weak keys retained for finalization, second-cycle userdata baseline and empty weak identities, no repeated finalizers, selected-owner bytes/blocks0 at shutdown. No metadata footprint waiver can substitute."
    }
  ],
