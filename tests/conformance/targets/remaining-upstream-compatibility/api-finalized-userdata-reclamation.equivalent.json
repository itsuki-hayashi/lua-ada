      "replacement": "  local udata_initial = T.totalmem(\"userdata\")\n  local udata_finalized = 0\n  local udata_keys = setmetatable({}, {__mode = \"k\"})\n  local udata_values = setmetatable({}, {__mode = \"v\"})\n  local udata_seen = {}\n  a = {__gc = function (u)\n    local id = udata_keys[u]\n    assert(type(u) == \"userdata\" and type(id) == \"number\")\n    assert(not udata_seen[id] and udata_values[id] == nil)\n    udata_seen[id] = true\n    udata_finalized = udata_finalized + 1\n  end}\n  for i=1,1000 do\n    local u = debug.setmetatable(T.newuserdata(0), a)\n    udata_keys[u], udata_values[i] = i, u\n  end",
      "invariant": "Create exactly the original1000 zero-sized userdata under the original stopped collector; observe each actual callback once and public weak-key/value lifecycle.",
