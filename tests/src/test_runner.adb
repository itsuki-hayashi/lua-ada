      Argument_Error_Tests.Register (Result);
      IO_Write_Error_Tests.Register (Result);
      Collector_Error_Tests.Register (Result);
      Argument_Registry_Tests.Register (Result);
      Metamethod_Root_Tests.Register (Result);
      Call_Error_Tests.Register (Result);
      Comparison_Branch_Tests.Register (Result);
      String_Constant_Tests.Register (Result);
      Stripped_Line_Tests.Register (Result);
      Lua.Execution_Retirement_Tests.Register (Result);
      Lua.Closing_Prefix_Tests.Register (Result);
      Lua.C_Thread_Reset_Tests.Register (Result);
      Lua.Constant_Pool_Tests.Register (Result);
      Runtime_Inspection_Tests.Register (Result);
      Lua.Opcode_Tests.Register (Result);
