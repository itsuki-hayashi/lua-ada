      case Exists is
         when True => Id : Kind;
         when False => null;
      end case;
   end record;

   function Find (Name : String) return Lookup;
   function Find (Address : System.Address) return Lookup;
   function Name (Id : Kind) return String;
   function Implementation (Id : Kind) return String;
   --  Semantic phase name; the retained old primitive IDs share their
   --  primitive driver, while named entries select their actual libraries.
   function Handler_Address (Id : Kind) return System.Address;
   --  Return actual callable C function bytes, portable across the supported
   --  function/object pointer ABI. The C shim uses memcpy, never a fabricated
   --  integer token or a callback address requiring a particular universe.
   procedure Initialize;
