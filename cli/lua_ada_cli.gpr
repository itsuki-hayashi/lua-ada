with "lua_ada";
with "config/lua_ada_cli_config.gpr";

project Lua_Ada_Cli is
   C_Import_Defines := ();
   case Lua_Ada_Cli_Config.Alire_Host_OS is
      when "linux" =>
         C_Import_Defines := ("-DLUA_ADA_CLI_LINUX");
      when "macos" =>
         C_Import_Defines := ("-DLUA_ADA_CLI_MACOS");
      when "windows" =>
         case Lua_Ada.Library_Mode is
            when "relocatable" =>
               C_Import_Defines := ("-DLUA_BUILD_AS_DLL");
            when others => null;
         end case;
      when others => null;
   end case;
   for Languages use ("Ada", "C");
   for Source_Dirs use ("src", "shared");
   for Object_Dir use
     "obj/" & Lua_Ada.Configuration_Subdir &
     Lua_Ada_Cli_Config.Build_Profile & "/" &
     Lua_Ada.Library_Mode;
   for Exec_Dir use
     "bin/" & Lua_Ada.Configuration_Subdir & Lua_Ada.Library_Mode;
   for Main use ("lua_ada.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("C") use
        ("-std=c99", "-Wall", "-Wextra", "-Werror", "-pedantic",
         "-I" & Project'Project_Dir & "../c_api/include/api") &
        C_Import_Defines;
      for Default_Switches ("Ada") use
        Lua_Ada_Cli_Config.Ada_Compiler_Switches &
        ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatv", "-gnaty",
         "-gnatVF");
   end Compiler;

   package Binder is
      --  Lua streams carry bytes. GNAT's UTF-8 default would encode each
      --  Character above 127, corrupting print output and stdin source.
      for Switches ("Ada") use ("-Wb");
   end Binder;
   package Linker is
      case Lua_Ada_Cli_Config.Alire_Host_OS is
         when "linux" =>
            for Default_Switches ("Ada") use ("-ldl");
         when "macos" =>
            for Default_Switches ("Ada") use ("-lreadline");
         when others => null;
      end case;
   end Linker;
end Lua_Ada_Cli;
