with "lua_ada";
with "config/lua_ada_cli_config.gpr";

project Lua_Ada_Cli is
   for Source_Dirs use ("src");
   for Object_Dir use
     "obj/" & Lua_Ada_Cli_Config.Build_Profile & "/" &
     Lua_Ada.Library_Mode;
   for Exec_Dir use "bin/" & Lua_Ada.Library_Mode;
   for Main use ("lua_ada.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        Lua_Ada_Cli_Config.Ada_Compiler_Switches &
        ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatv", "-gnaty");
   end Compiler;
end Lua_Ada_Cli;
