with "../lua_ada";
with "../config/lua_ada_config.gpr";

project Image_Consumer is
   for Languages use ("Ada", "C");
   for Source_Dirs use ("tests/core_image");
   for Object_Dir use
     "../build/c-api/image/obj/" & Lua_Ada.Configuration_Subdir &
       Lua_Ada_Config.Build_Profile & "/" & Lua_Ada.Library_Mode;
   for Exec_Dir use
     "../build/c-api/image/bin/" & Lua_Ada.Configuration_Subdir &
       Lua_Ada_Config.Build_Profile & "/" & Lua_Ada.Library_Mode;
   for Main use ("lua-core_image_check.adb", "c_image_client.c");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        Lua_Ada_Config.Ada_Compiler_Switches &
        ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatv", "-gnaty",
         "-gnatVF");
      for Default_Switches ("C") use
        ("-std=c99", "-Wall", "-Wextra", "-Werror", "-pedantic",
         "-I" & Project'Project_Dir & "include/api");
   end Compiler;

   package Linker is
      case Lua_Ada_Config.Alire_Host_OS is
         when "macos" =>
            for Default_Switches ("Ada") use
              ("-lm", "-Wl,-u,___gnat_tasking_runtime_initialize",
               external ("LUA_ADA_TASKING_RUNTIME_ARCHIVE", ""));
            for Default_Switches ("C") use
              ("-lm", "-Wl,-u,___gnat_tasking_runtime_initialize",
               external ("LUA_ADA_TASKING_RUNTIME_ARCHIVE", ""),
               external ("LUA_ADA_ABI_RUNTIME_ARCHIVE", ""));
         when others =>
            for Default_Switches ("Ada") use ("-lm");
            for Default_Switches ("C") use ("-lm");
      end case;
   end Linker;
end Image_Consumer;
