with "../config/lua_ada_config.gpr";
with "../runtime_configuration";

library project Lua_C_API is
   type Library_Type is ("static", "static-pic", "relocatable");
   Library_Mode : Library_Type :=
     external ("LUA_ADA_LIBRARY_TYPE", "static");
   Configuration_Subdir := Runtime_Configuration.Artifact_Subdir;
   C_ABI_Defines := ();
   case Lua_Ada_Config.Alire_Host_OS is
      when "windows" =>
         case Library_Mode is
            when "relocatable" =>
               C_ABI_Defines :=
                 ("-DLUA_BUILD_AS_DLL", "-DLUA_CORE", "-DLUA_LIB");
            when others => null;
         end case;
      when others => null;
   end case;

   for Languages use ("Ada", "C");
   for Source_Dirs use
     ("../src", "../config", "ada", "c",
      Runtime_Configuration.Source_Directory);
   for Object_Dir use
     "../build/c-api/obj/" & Configuration_Subdir &
       Lua_Ada_Config.Build_Profile & "/" &
       Library_Mode;
   for Library_Dir use
     "../build/c-api/lib/" & Configuration_Subdir &
       Lua_Ada_Config.Build_Profile & "/" &
       Library_Mode;
   for Library_Name use "lua";
   for Library_Kind use Library_Mode;
   for Library_Interface use ("Lua", "Lua.C_API");
   for Library_Standalone use "standard";
   for Library_Auto_Init use "true";
   for Create_Missing_Dirs use "True";
   case Lua_Ada_Config.Alire_Host_OS is
      when "linux" | "macos" =>
         for Library_Options use ("-lm");
      when others => null;
   end case;

   package Compiler is
      for Default_Switches ("Ada") use
        Lua_Ada_Config.Ada_Compiler_Switches &
        ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatv", "-gnaty",
         "-gnatVF");
      for Default_Switches ("C") use
        ("-std=c99", "-Wall", "-Wextra", "-Werror", "-pedantic",
         "-I" & Project'Project_Dir & "include",
         "-I" & Project'Project_Dir & "include/api") &
        C_ABI_Defines;
   end Compiler;
end Lua_C_API;
