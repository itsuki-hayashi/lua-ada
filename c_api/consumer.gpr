with "lua_c_api";
with "../config/lua_ada_config.gpr";

project Consumer is
   Library_Mode := external ("LUA_ADA_LIBRARY_TYPE", "static");
   for Languages use ("C");
   for Source_Dirs use ("tests");
   for Object_Dir use
     "../build/c-api/consumer/" & Lua_C_API.Configuration_Subdir &
       Lua_Ada_Config.Build_Profile & "/" &
       Library_Mode;
   for Exec_Dir use
     "../build/c-api/bin/" & Lua_C_API.Configuration_Subdir &
       Lua_Ada_Config.Build_Profile & "/" &
       Library_Mode;
   for Main use ("c_api_consumer.c");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("C") use
        ("-std=c99", "-Wall", "-Wextra", "-Werror", "-pedantic",
         "-I" & Project'Project_Dir & "include",
         "-I" & Project'Project_Dir & "include/api");
   end Compiler;
   package Linker is
      case Lua_Ada_Config.Alire_Host_OS is
         when "linux" =>
            for Default_Switches ("C") use ("-lm");
         when "macos" =>
            for Default_Switches ("C") use
              ("-lm", external ("LUA_ADA_ABI_RUNTIME_ARCHIVE", ""));
         when others => null;
      end case;
   end Linker;
end Consumer;
