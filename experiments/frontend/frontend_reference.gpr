with "../../config/lua_ada_config.gpr";

library project Frontend_Reference is
   type Configuration_Type is ("default", "upstream-test");
   Configuration : Configuration_Type :=
     external ("LUA_FRONTEND_CONFIGURATION", "default");
   --  A separate static oracle keeps the public ABI oracle unchanged while
   --  matching the parser's selected language switches and private layouts.
   Sources :=
     ("lapi.c", "lauxlib.c", "lbaselib.c", "lcode.c", "lcorolib.c",
      "lctype.c", "ldblib.c", "ldebug.c", "ldo.c", "ldump.c", "lfunc.c",
      "lgc.c", "linit.c", "liolib.c", "llex.c", "lmathlib.c", "lmem.c",
      "loadlib.c", "lobject.c", "lopcodes.c", "loslib.c", "lparser.c",
      "lstate.c", "lstring.c", "lstrlib.c", "ltable.c", "ltablib.c",
      "ltm.c", "lundump.c", "lutf8lib.c", "lvm.c", "lzio.c");
   Platform := ();
   Mode := ();
   case Lua_Ada_Config.Alire_Host_OS is
      when "linux" => Platform := ("-DLUA_USE_LINUX");
      when "macos" => Platform := ("-DLUA_USE_MACOSX");
      when others => null;
   end case;
   case Configuration is
      when "default" =>
         for Source_Files use Sources;
      when "upstream-test" =>
         Mode := ("-DLUA_USER_H=<ltests.h>");
         for Source_Files use Sources & ("ltests.c");
   end case;
   for Languages use ("C");
   for Source_Dirs use ("../../references/lua");
   for Object_Dir use
     "../../build/frontend/" & Configuration & "/reference-obj";
   for Library_Dir use
     "../../build/frontend/" & Configuration & "/reference-lib";
   for Library_Name use "frontend_reference";
   for Library_Kind use "static";
   for Create_Missing_Dirs use "True";
   package Compiler is
      for Default_Switches ("C") use
        ("-std=c99", "-O2") & Platform & Mode;
   end Compiler;
end Frontend_Reference;
