with "frontend_reference";
with "../../config/lua_ada_config.gpr";
project Frontend_Oracle is
   for Languages use ("C");
   for Source_Dirs use (".");
   for Source_Files use ("frontend_oracle.c");
   for Object_Dir use
     "../../build/frontend/" & Frontend_Reference.Configuration & "/lexer-obj";
   for Exec_Dir use
     "../../build/frontend/" & Frontend_Reference.Configuration;
   for Main use ("frontend_oracle.c");
   for Create_Missing_Dirs use "True";
   package Compiler is
      for Default_Switches ("C") use
        ("-std=c99", "-O2", "-Wall", "-Wextra", "-Werror") &
        Frontend_Reference.Mode;
   end Compiler;
   package Linker is
      --  The C parser pulls numeric VM helpers from the reference archive.
      --  Match pinned makefile's explicit libm link on every target host.
      case Lua_Ada_Config.Alire_Host_OS is
         when "linux" =>
            for Default_Switches ("C") use ("-lm", "-ldl");
         when "macos" | "windows" =>
            for Default_Switches ("C") use ("-lm");
         when others => null;
      end case;
   end Linker;
end Frontend_Oracle;
