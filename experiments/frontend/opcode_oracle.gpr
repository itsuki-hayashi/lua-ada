with "../abi/reference_lua";
project Opcode_Oracle is
   for Languages use ("C");
   for Source_Dirs use (".");
   for Source_Files use ("opcode_oracle.c");
   for Object_Dir use "../../build/frontend/opcode-obj";
   for Exec_Dir use "../../build/frontend";
   for Main use ("opcode_oracle.c");
   for Create_Missing_Dirs use "True";
   package Compiler is
      for Default_Switches ("C") use
        ("-std=c99", "-O2", "-Wall", "-Wextra", "-Werror");
   end Compiler;
end Opcode_Oracle;
