Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

function Resolve-ReviewedFile {
    param([string] $Root, [string] $Path, [string] $Sha256)
    # Review identities are repository-relative, content-addressed files. A
    # fragment names a case inside a source; it never changes the hashed file.
    if ([string]::IsNullOrWhiteSpace($Path) -or [IO.Path]::IsPathRooted($Path) -or
        $Sha256 -cnotmatch '^[0-9a-f]{64}$') { throw 'Invalid review file identity' }
    $filePart = $Path.Split('#')[0]
    $rootPath = [IO.Path]::GetFullPath($Root)
    $file = [IO.Path]::GetFullPath((Join-Path $rootPath $filePart))
    $relative = [IO.Path]::GetRelativePath($rootPath, $file)
    if ($relative -eq '..' -or $relative.StartsWith('..' + [IO.Path]::DirectorySeparatorChar) -or
        [IO.Path]::IsPathRooted($relative) -or -not (Test-Path -LiteralPath $file -PathType Leaf)) {
        throw 'Review file is missing or outside repository'
    }
    if ((Get-FileHash -LiteralPath $file -Algorithm SHA256).Hash.ToLowerInvariant() -cne $Sha256) {
        throw 'Review file hash differs'
    }
    return $file
}

function Read-ReviewApproval {
    param([string] $Root, [Collections.IDictionary] $Review, [string] $Kind)
    if ($null -eq $Review -or $Review.status -cne 'accepted' -or
        [string]::IsNullOrWhiteSpace([string]$Review.author) -or
        [string]::IsNullOrWhiteSpace([string]$Review.reviewer) -or
        $Review.author -ceq $Review.reviewer) { throw 'Review approval is not independent and accepted' }
    $path = Resolve-ReviewedFile -Root $Root -Path $Review.artifact -Sha256 $Review.artifact_sha256
    $approval = Get-Content -LiteralPath $path -Raw | ConvertFrom-Json -AsHashtable -Depth 64
    if ($approval.schema_version -ne 1 -or $approval.kind -cne $Kind -or
        $approval.decision -cne 'accepted' -or $approval.author -cne $Review.author -or
        $approval.reviewer -cne $Review.reviewer) { throw 'Review approval identity or decision differs' }
    return $approval
}

function Assert-ReviewEvidence {
    param([string] $Root, [Collections.IDictionary] $Evidence, [string] $Reviewer)
    if ($null -eq $Evidence) { throw 'Review decision lacks independent evidence' }
    $path = Resolve-ReviewedFile -Root $Root -Path $Evidence.path -Sha256 $Evidence.sha256
    $narrative = Get-Content -LiteralPath $path -Raw | ConvertFrom-Json -AsHashtable -Depth 64
    # A narrative may have unrelated changes-required findings. Its identity
    # binds the explicit per-span decision without falsely approving all work.
    if ($narrative.reviewer -cne $Reviewer) { throw 'Review evidence names a different reviewer' }
}

function Assert-EquivalentReviewBinding {
    param([Parameter(Mandatory)][string] $Root,
          [Parameter(Mandatory)][Collections.IDictionary] $Specification,
          [Parameter(Mandatory)][string] $GeneratedSha256)
    $approval = Read-ReviewApproval -Root $Root -Review $Specification.review -Kind 'equivalent-approval'
    $identity = $approval.equivalent
    if ($null -eq $identity) { throw 'Equivalent approval identity missing' }
    foreach ($field in @('id','source','source_sha256','configuration','disposition')) {
        $expected = $Specification[$field]
        if ($field -eq 'disposition' -and -not $Specification.Contains($field)) { $expected='ada-internal-equivalent' }
        if ($identity[$field] -cne $expected) { throw "Equivalent approval differs: $field" }
    }
    $platform = if ($Specification.Contains('platform')) { $Specification.platform } else { $null }
    if ($identity.platform -cne $platform -or $identity.generated_sha256 -cne $GeneratedSha256 -or
        $GeneratedSha256 -cnotmatch '^[0-9a-f]{64}$') { throw 'Equivalent approval platform or generated bytes differ' }
    [void](Resolve-ReviewedFile -Root $Root -Path $Specification.source -Sha256 $Specification.source_sha256)
    $decisions = @($approval.decisions)
    if ($decisions.Count -ne @($Specification.replacements).Count) { throw 'Equivalent review decision set differs' }
    $seen = @{}
    foreach ($replacement in $Specification.replacements) {
        $matches = @($decisions | Where-Object { $_.id -ceq $replacement.id })
        if ($matches.Count -ne 1 -or $seen.ContainsKey($replacement.id)) { throw 'Equivalent review decision missing or duplicated' }
        $seen[$replacement.id] = $true
        $decision = $matches[0]
        if ($decision.decision -cne 'accepted' -or
            [string]::IsNullOrWhiteSpace([string]$decision.author) -or
            [string]::IsNullOrWhiteSpace([string]$decision.reviewer) -or
            $decision.author -ceq $decision.reviewer -or
            [string]::IsNullOrWhiteSpace([string]$decision.rationale)) {
            throw 'Equivalent span lacks independent acceptance'
        }
        foreach ($field in @('start_byte','length_bytes','source_sha256')) {
            if ($decision[$field] -cne $replacement[$field]) { throw 'Equivalent review span differs' }
        }
        $bytes = [Text.Encoding]::UTF8.GetBytes([string]$replacement.replacement)
        $hash = [Convert]::ToHexString([Security.Cryptography.SHA256]::HashData($bytes)).ToLowerInvariant()
        if ($decision.replacement_sha256 -cne $hash) { throw 'Equivalent reviewed replacement differs' }
        Assert-ReviewEvidence -Root $Root -Evidence $decision.review_evidence -Reviewer $decision.reviewer
        $counterparts = @($decision.counterparts)
        if ($counterparts.Count -ne @($replacement.counterpart_tests).Count) { throw 'Equivalent reviewed counterpart set differs' }
        $counterpartSeen = @{}
        foreach ($test in $replacement.counterpart_tests) {
            $records = @($counterparts | Where-Object { $_.path -ceq $test })
            if ($records.Count -ne 1 -or $counterpartSeen.ContainsKey($test)) { throw 'Equivalent reviewed counterpart missing or duplicated' }
            $counterpartSeen[$test] = $true
            [void](Resolve-ReviewedFile -Root $Root -Path $test -Sha256 $records[0].sha256)
        }
    }
}

function Assert-MatrixReviewBinding {
    param([Parameter(Mandatory)][string] $Root,
          [Parameter(Mandatory)][Collections.IDictionary] $Manifest)
    $approval = Read-ReviewApproval -Root $Root -Review $Manifest.review -Kind 'matrix-approval'
    if ($approval.scope -cne $Manifest.scope -or $approval.revision -cne $Manifest.revision -or
        @($approval.operations).Count -ne @($Manifest.operations).Count) {
        throw 'Matrix review identity or operation set differs'
    }
    Assert-ReviewEvidence -Root $Root -Evidence $approval.review_evidence -Reviewer $approval.reviewer
    $seen = @{}
    foreach ($entry in $Manifest.operations) {
        $matches = @($approval.operations | Where-Object { $_.file -ceq $entry.file -and $_.context -ceq $entry.context })
        $key = $entry.context + '/' + $entry.file
        if ($matches.Count -ne 1 -or $seen.ContainsKey($key)) { throw 'Matrix review operation missing or duplicated' }
        $seen[$key] = $true
        $decision = $matches[0]
        if ($decision.decision -cne 'accepted' -or
            $decision.c_report_sha256 -cne $entry.c.sha256 -or
            $decision.ada_report_sha256 -cne $entry.ada.sha256 -or
            $decision.contract_sha256 -cne $entry.contract.sha256) {
            throw 'Matrix reviewed report or contract differs'
        }
    }
    # Named regressions are evidence inputs in their own right. Bind their
    # report identities to the final independent review, just like file runs.
    foreach ($kind in @('consumer','aunit')) {
        $mapping = $Manifest["${kind}_mapping"]
        $approvedMapping = $approval["${kind}_mapping"]
        foreach ($field in @('path','sha256','review','review_sha256')) {
            if ($null -eq $mapping -or $null -eq $approvedMapping -or
                [string]::IsNullOrWhiteSpace([string]$mapping[$field]) -or
                $mapping[$field] -cne $approvedMapping[$field]) { throw 'Matrix named mapping review differs' }
        }
        $field = if ($kind -eq 'consumer') { 'named_consumers' } else { 'named_aunit' }
        $entries = @($Manifest[$field])
        $approved = @($approval[$field])
        if ($entries.Count -eq 0 -or $entries.Count -ne $approved.Count) { throw 'Matrix named report set differs' }
        $seen = @{}
        foreach ($entry in $entries) {
            $matches = @($approved | Where-Object { $_.context -ceq $entry.context })
            if ($matches.Count -ne 1 -or $seen.ContainsKey($entry.context) -or
                $matches[0].decision -cne 'accepted' -or $matches[0].sha256 -cne $entry.sha256) {
                throw 'Matrix named report review differs'
            }
            $seen[$entry.context] = $true
        }
    }
}

function Assert-NativeBranchReviewBinding {
    param([Parameter(Mandatory)][string] $Root,
          [Parameter(Mandatory)][Collections.IDictionary] $Identity)
    # Supplemental native executions leave the original file intact. Bind
    # their explicitly reviewed source spans and counterpart bytes separately
    # instead of treating an inactive original branch as an unchanged pass.
    $path = Resolve-ReviewedFile -Root $Root -Path $Identity.mapping -Sha256 $Identity.mapping_sha256
    $mapping = Get-Content -LiteralPath $path -Raw | ConvertFrom-Json -AsHashtable -Depth 32
    $path = Resolve-ReviewedFile -Root $Root -Path $Identity.review -Sha256 $Identity.review_sha256
    $review = Get-Content -LiteralPath $path -Raw | ConvertFrom-Json -AsHashtable -Depth 32
    if ($mapping.kind -cne 'native-branch-counterpart-proposal' -or
        $review.kind -cne 'independent-native-counterpart-review' -or
        $review.revision_review.decision -cne 'accepted-semantic-mapping' -or
        [string]::IsNullOrWhiteSpace([string]$mapping.author) -or
        [string]::IsNullOrWhiteSpace([string]$review.reviewer) -or
        $review.author -cne $mapping.author -or $review.author -ceq $review.reviewer) {
        throw 'Native branch mapping lacks independent semantic approval'
    }
    foreach ($binding in @(
        @{path=$Identity.mapping; sha256=$Identity.mapping_sha256},
        @{path=$mapping.counterpart.path; sha256=$mapping.counterpart.sha256})) {
        $matches = @($review.revision_review.bindings | Where-Object {
            $_.path -ceq $binding.path -and $_.sha256 -ceq $binding.sha256 })
        if ($matches.Count -ne 1) { throw 'Native branch review does not bind current mapping and counterpart' }
        [void](Resolve-ReviewedFile -Root $Root -Path $binding.path -Sha256 $binding.sha256)
    }
    $source = Resolve-ReviewedFile -Root $Root -Path $mapping.source -Sha256 $mapping.source_sha256
    $bytes = [IO.File]::ReadAllBytes($source)
    $seen = @{}
    if (@($mapping.branches).Count -eq 0) { throw 'Native branch mapping is empty' }
    foreach ($branch in $mapping.branches) {
        if ([string]::IsNullOrWhiteSpace([string]$branch.id) -or $seen.ContainsKey($branch.id) -or
            [string]::IsNullOrWhiteSpace([string]$branch.counterpart_invariant) -or
            [string]::IsNullOrWhiteSpace([string]$branch.required_marker) -or
            @($branch.source_spans).Count -eq 0) { throw 'Native branch mapping lacks distinct obligations' }
        $seen[$branch.id]=$true
        foreach ($span in $branch.source_spans) {
            if ($span.byte_offset -lt 0 -or $span.byte_length -le 0 -or
                $span.byte_offset -gt $bytes.Length -or
                $span.byte_length -gt $bytes.Length - $span.byte_offset) {
                throw 'Native branch source span outside original'
            }
            $slice = [byte[]]::new($span.byte_length)
            [Array]::Copy($bytes,$span.byte_offset,$slice,0,$slice.Length)
            $hash = [Convert]::ToHexString([Security.Cryptography.SHA256]::HashData($slice)).ToLowerInvariant()
            if ($hash -cne $span.sha256) { throw 'Native branch source span differs' }
        }
    }
    return $mapping
}

function Assert-NativeBranchWitnesses {
    param([Parameter(Mandatory)][Collections.IDictionary] $Mapping,
          [Parameter(Mandatory)][string] $Output)
    foreach ($branch in $Mapping.branches) {
        $pattern='(?m)^'+[regex]::Escape($branch.required_marker)+'\r?$'
        if ([regex]::Matches($Output,$pattern).Count -ne 1) {
            throw "Native branch reviewed completion witness missing or duplicated: $($branch.id)"
        }
    }
}

Export-ModuleMember -Function Resolve-ReviewedFile, Assert-EquivalentReviewBinding, Assert-MatrixReviewBinding, Assert-NativeBranchReviewBinding, Assert-NativeBranchWitnesses
